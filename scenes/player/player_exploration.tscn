[node name="DDDialogue" type="Node" parent="HUD/Dialogues" unique_id=1304335187]

[node name="Intro" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=1258971252]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 578.0
text = "Fala ADM, veio me banir de novo ou vamo trocar uma ideia mais suave agora? Se tiver disposto podemos colocar nossas diferenças de lado, com o servidor acabando não vale muito a pena ficar remoendo treta passada."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Call" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=1765831772]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 577.0
text = "Se tiver afim de conversar só aceitar a call irmão tô disposto ae. Eae, como que vai ser?

RECUSAR?                                              ACEITAR?"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="CallAccept" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=1547895662]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 578.0
text = "Bora dançar então!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CallDecline" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=890667725]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 916.0
offset_bottom = 579.0
text = "Pss deixar pra depois o que você podia resolver agora não vai mudar o resultado..."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="BadEnding" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=363468292]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 916.0
offset_bottom = 578.0
text = " É mano.. Como um conversador você é um ótimo administrador… não sei o que esperava sair disso, mas enfim
espero nunca mais te encontrar, então fi, flw ..i."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="NeutralEnding" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=1019947892]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 917.0
offset_bottom = 578.0
text = "É… achei que algo poderia mudar na nossa relação, mas fica na mesmice então, vai na fé."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="GoodEnding" type="Label" parent="HUD/Dialogues/DDDialogue" unique_id=96167284]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 580.0
text = "Po cara, você é um cara maneiro até, vlw pela sua mensagem. Sei que nosso santo não bateu inicialmente, mas agradeço por ter tirado um pouco do seu tempo. Espero que algum dia você escute minhas músicas lá fora, tmj mano!"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="DDCombatDialogue" type="Node" parent="HUD/Dialogues" unique_id=1454845725]

[node name="Question1" type="Label" parent="HUD/Dialogues/DDCombatDialogue" unique_id=490618271]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 917.0
offset_bottom = 579.0
text = "Depois do meu banimento eu vi que você revogou e me permitiu entrar de novo no server, qual foi o motivo exato? Porque a galera que ia nos meus shows criticava a falta de compromisso dos ADMS e né não deve ter sido muito maneiro ouvir uma galera reclamando de vocês, já que o server vai acabar pode ser sincero ae."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Question2" type="Label" parent="HUD/Dialogues/DDCombatDialogue" unique_id=1127926647]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 919.0
offset_bottom = 580.0
text = "Agora que a gente colocou os pingos nos is, olhando pra trás eu acho que os shows podiam ser até melhores, colocar uns efeitos de luzes mais intensos, melhorar o som do server ou outras coisas do tipo, deve dar um trabalho pros devs mas seria maneiro, queria ter feito mais."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Question3" type="Label" parent="HUD/Dialogues/DDCombatDialogue" unique_id=1514869601]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 578.0
text = "Pra ser sincero, eu to meio bolado com o fim do server, não entendi muito bem o motivo do server acabar mas né, o que eu posso fazer… só fico pensando em como conseguir construir uma carreira fora do HyperNet… seila, eu fui aceito por uma galera muito legal aqui dentro, vai ser difícil recomeçar."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Conclusion" type="Label" parent="HUD/Dialogues/DDCombatDialogue" unique_id=1469806324]
visible = false
offset_left = 320.0
offset_top = 410.0
offset_right = 918.0
offset_bottom = 578.0
text = "Enfim… vou sentir falta do servidor e acho que as respostas que eu queria eu encontrei…"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

